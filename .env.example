# Server-side secrets. Set these in Vercel → Project → Settings → Environment Variables.
# Added automatically when you connect Upstash for Redis from the Storage tab:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Any long random string; protects /api/list-submissions
ADMIN_TOKEN=
# Optional: confirmation emails via resend.com
RESEND_API_KEY=
EMAIL_FROM="Roomie <hello@roomie.app>"
